          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Reconciliation is idempotent\", () => { pm.response.to.have.status(200); pm.expect(j.data.policy_number).to.eql(pm.collectionVariables.get(\"policy_number\")); pm.expect(j.data.submission_attempt_count).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/policy-requests/{{policy_id}}/reconcile"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "client_request_id",
      "value": ""
    },
    {
      "key": "policy_id",
      "value": ""
    },
    {
      "key": "policy_number",
      "value": ""
    },
    {
      "key": "retry_key",
      "value": ""
    }
  ]
}
