          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mock-insurer/policy-requests/{{policy_id}}/dispatch-callbacks"
          }
        },
        {
          "name": "08 Repeat submit cannot reissue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Still one issuance\", () => { pm.response.to.have.status(200); pm.expect(j.data.policy_number).to.eql(pm.collectionVariables.get(\"policy_number\")); pm.expect(j.data.submission_attempt_count).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/policy-requests/{{policy_id}}/submit"
          }
        }
      ]
