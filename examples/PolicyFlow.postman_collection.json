            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\",\n  \"agent_id\": \"POSTMAN-AGENT\",\n  \"customer_name\": \"Sample Customer\",\n  \"date_of_birth\": \"1998-04-10\",\n  \"destination\": \"INTERNATIONAL\",\n  \"trip_start\": \"2026-11-10\",\n  \"trip_end\": \"2026-11-14\",\n  \"plan_code\": \"GOLD\",\n  \"sum_insured\": 300000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/policy-requests"
          }
        },
        {
          "name": "06 Submit successfully",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Issued exactly once\", () => { pm.response.to.have.status(200); pm.expect(j.data.status).to.eql(\"ISSUED\"); pm.expect(j.data.submission_attempt_count).to.eql(1); pm.expect(j.data.policy_number).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"policy_number\", j.data.policy_number);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/policy-requests/{{policy_id}}/submit"
          }
        },
        {
          "name": "07 Dispatch is correctly blocked without queued callback",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Expected conflict, not a failed issuance\", () => { pm.response.to.have.status(409); pm.expect(j.message).to.eql(\"No mock callback is queued for this request.\"); });"
                ]
              }
