{
  "info": {
    "name": "PolicyFlow local API verification",
    "description": "Run folders in order, or run the whole collection. Each create request generates a fresh fabricated client_request_id. Uses only the local mock insurer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Intake and success",
      "item": [
        {
          "name": "01 Create fresh policy",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"client_request_id\", \"PF-POSTMAN-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Created one policy\", () => { pm.response.to.have.status(201); pm.expect(j.data).to.be.an(\"object\"); pm.expect(j.data.id).to.be.a(\"number\"); pm.expect(j.data.status).to.eql(\"VALIDATED\"); pm.expect(j.data.premium_amount).to.eql(\"225.00\"); });",
                  "pm.collectionVariables.set(\"policy_id\", String(j.data.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\",\n  \"agent_id\": \"POSTMAN-AGENT\",\n  \"customer_name\": \"Sample Customer\",\n  \"date_of_birth\": \"1998-04-10\",\n  \"destination\": \"INTERNATIONAL\",\n  \"trip_start\": \"2026-11-10\",\n  \"trip_end\": \"2026-11-14\",\n  \"plan_code\": \"PLUS\",\n  \"sum_insured\": 300000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/policy-requests"
          }
        },
        {
          "name": "02 List includes the new policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Newest policy is first\", () => { pm.response.to.have.status(200); pm.expect(j.data).to.be.an(\"array\"); pm.expect(j.data[0].id).to.eql(Number(pm.collectionVariables.get(\"policy_id\"))); pm.expect(j.pagination.total).to.be.greaterThan(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/policy-requests?per_page=100"
          }
        },
        {
          "name": "03 Detail matches created policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Detail shows persisted request\", () => { pm.response.to.have.status(200); pm.expect(j.data.id).to.eql(Number(pm.collectionVariables.get(\"policy_id\"))); pm.expect(j.data.client_request_id).to.eql(pm.collectionVariables.get(\"client_request_id\")); pm.expect(j.data.premium_amount).to.eql(\"225.00\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/policy-requests/{{policy_id}}"
          }
        },
        {
          "name": "04 Repeat intake key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Duplicate reuses policy\", () => { pm.response.to.have.status(200); pm.expect(j.data.id).to.eql(Number(pm.collectionVariables.get(\"policy_id\"))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\",\n  \"agent_id\": \"POSTMAN-AGENT\",\n  \"customer_name\": \"Sample Customer\",\n  \"date_of_birth\": \"1998-04-10\",\n  \"destination\": \"INTERNATIONAL\",\n  \"trip_start\": \"2026-11-10\",\n  \"trip_end\": \"2026-11-14\",\n  \"plan_code\": \"PLUS\",\n  \"sum_insured\": 300000\n}",
              "options": {
                "raw": {
                  "language": "json"
